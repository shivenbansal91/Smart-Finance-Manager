# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to Git.
# ─────────────────────────────────────────────────────────────────────────────

# Oracle DB connection
DB_USER=system
DB_PASSWORD=your_oracle_password_here
DB_CONNECT_STR=localhost:1521/XEPDB1

# JWT secret — use any long random string (min 32 chars)
JWT_SECRET=replace_with_a_long_random_secret_string

# API server port
API_PORT=3001

# Frontend: point to the running API server
VITE_API_URL=http://localhost:3001
